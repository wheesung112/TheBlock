				float3 triplanar102 = TriplanarSampling102( _SnowNormal, sampler_SnowNormal, IN.ase_texcoord8.xyz, IN.ase_normal, 1.0, _Vector0, 1.0, 0 );
				float3 tanTriplanarNormal102 = mul( objectToTangent, triplanar102 );
				float3 SnowNormal14 = tanTriplanarNormal102;
